# Generate with: bin/rails secret
SECRET_KEY_BASE=

# Required when decrypting Rails credentials in production.
RAILS_MASTER_KEY=

# Production application URL and host (without https://).
APP_HOST=calendar.example.com
APP_PROTOCOL=https

# Set these to false only when TLS is terminated outside the Rails process.
RAILS_ASSUME_SSL=true
RAILS_FORCE_SSL=true

# PostgreSQL credentials for the primary, cache, queue, and cable databases.
THE_NOTEBOOK_CALENDAR_DATABASE_PASSWORD=

# Postmark SMTP settings for magic-link email delivery.
# Verify MAILER_FROM in Postmark before sending production mail.
POSTMARK_SERVER_TOKEN=
SMTP_ADDRESS=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_DOMAIN=calendar.example.com
SMTP_USERNAME=postmark
# SMTP_PASSWORD is only needed when using a provider other than Postmark.
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
MAILER_FROM=no-reply@calendar.example.com